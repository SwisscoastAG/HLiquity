# Reference artifact for the batch-transaction exit guide - companion artifact of the batch-transaction exit guide.
# Copy to .env and fill in. NEVER commit a real .env. Never hardcode keys in source.

# Operator account that pays for (and, in this CLI, signs) the transactions.
# In this reference CLI the operator IS the user account (userId = operator account).
OPERATOR_ID=0.0.XXXXXXX
# Operator private key as hex-encoded DER (302e02... for ED25519). Alternatively a raw
# 32-byte hex key works with PrivateKey.fromStringED25519 - see hliquity-batch.js.
OPERATOR_KEY_DER=302e020100300506032b657004220420...

# Network: testnet | mainnet. ALWAYS validate on testnet first, then mainnet with small amounts.
NETWORK=testnet

# Optional mirror-node override (defaults derived from NETWORK):
# MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
