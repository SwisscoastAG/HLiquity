# Reference artifact for the batch-transaction exit guide - companion artifact of the batch-transaction exit guide.
# Copy to .env and fill in. NEVER commit a real .env. Never hardcode keys in source.

# Operator account that pays for (and, in this CLI, signs) the transactions.
# In this reference CLI the operator IS the user account (userId = operator account).
OPERATOR_ID=0.0.XXXXXXX
# Operator private key. DER-prefixed keys are detected automatically. For a raw
# 32-byte key, set OPERATOR_KEY_TYPE explicitly (defaults to ed25519).
OPERATOR_KEY_DER=302e020100300506032b657004220420...
OPERATOR_KEY_TYPE=ed25519

# Mainnet only: the bundled registry contains mainnet contract/token IDs.
NETWORK=mainnet

# Optional mirror-node override (defaults derived from NETWORK):
# MIRROR_NODE_URL=https://mainnet.mirrornode.hedera.com

# Optional JSON-RPC relay used for eth_call redemption simulations. SDK local
# ContractCallQuery cannot simulate fetchPrice() because it may write state.
# JSON_RPC_RELAY_URL=https://mainnet.hashio.io/api
